<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">

</head>

<body>
    <a href="/">Foldal</a>
    <a href="/new">Felvetel</a>
    <a href="/stats">statisztika</a>

    <form method="get">
        <select name=category>
            <option value="elektronika">elektronika</option>
            <option value="ruházat">ruhazat</option>
            <option value="könyv">konyv</option>
            <option value="játék">jatek</option>
        </select>
        <button type="submit">szűrés</button>
    </form>


    <table>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
        </tr>

        <% products.forEach(product=> { %>
            <tr>
                    <td>
                        <%= product.name %>
                    </td>
                    <td>
                        <%= product.category %>
                    </td>
                    <td>
                        <%= product.price %>
                    </td>
                    <td>
                        <%= product.stock %>
                    </td>
            </tr>
            <% }) %>
    </table>
</body>

</html>