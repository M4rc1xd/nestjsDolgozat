<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <a href="/filter">Szures</a>
    <a href="/new">Felvetel</a>
    <a href="/stats">statisztika</a>

    <table>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
        </tr>
        
        <% products.forEach(product => { %>
            <tr <% if (product.stock < 5) { %> style="color: red; font-weight: bold;" <% } %>>
                <td><%= product.name %></td>
                <td><%= product.category %></td>
                <td><%= product.price %></td>
                <td><%= product.stock %></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>